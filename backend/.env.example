PORT=5000

# Local MongoDB URI
MONGO_URI=mongodb://127.0.0.1:27017/bidlive

# MongoDB Atlas URI Format Example (replace <username>, <password>, and <cluster-url>):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/bidlive?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Secret registration code required to register as an Admin user
ADMIN_REGISTRATION_CODE=ADMIN123
